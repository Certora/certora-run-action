# Find the main checkout through git, so this also works in a worktree
main_checkout="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)")"

if command -v nix &> /dev/null
then
    source_env_if_exists "$main_checkout/../.envrc"
    # Use nix if it's available
    use flake
fi

layout node

if [ ! -f .git/hooks/pre-commit ]; then
    pre-commit install
fi

# Export variables from .env
# A worktree has no .env of its own, so fall back to the main checkout's
env_file=.env
[ -f "$env_file" ] || env_file="$main_checkout/.env"
watch_file "$env_file"
set -a
[ -f "$env_file" ] && . "$env_file"
set +a
